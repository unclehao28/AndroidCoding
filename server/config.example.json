{
  "_comment": [
    "安卓源码工作台后端配置（P1）。复制为 server/config.json 后按服务器实际情况修改。",
    "roots[].path 支持绝对路径或相对本文件所在目录的路径；只能列出确实需要的源码根目录，不要写 /。",
    "配置校验：cd server && python -m app --config config.json --check-config",
    "字段名不允许拼错：未知字段、类型错误、越界数值、不存在的根目录都会导致启动失败并列出全部问题。",
    "端口默认 8787 而不是 8765：8765 常被本机代理工具（如 Clash）占用，会导致 SSH 本地转发绑定失败。"
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "corsOrigins": ["*"]
  },
  "roots": [
    {
      "id": "demo",
      "name": "演示源码（fixtures/demo-tree）",
      "path": "../fixtures/demo-tree",
      "readonly": true
    },
    {
      "id": "fixtures",
      "name": "验收样例（fixtures）",
      "path": "../fixtures",
      "readonly": true
    }
  ],
  "limits": {
    "maxFileBytes": 2097152,
    "maxLineCount": 2000,
    "maxTreeEntries": 2000,
    "maxSearchResults": 500,
    "maxSearchFileBytes": 1048576,
    "searchTimeoutSeconds": 10,
    "maxConcurrentSearches": 2,
    "maxRegexLength": 200,
    "maxLineLength": 400,
    "rgThreads": 2
  },
  "search": {
    "engine": "auto",
    "respectIgnoreFiles": true,
    "pythonMaxFiles": 20000,
    "excludeGlobs": [
      ".git/**",
      ".repo/**",
      "out/**",
      "**/out/**",
      "*.o",
      "*.a",
      "*.so",
      "*.jar",
      "*.apk",
      "*.img",
      "*.zip"
    ]
  },
  "features": {
    "write": false,
    "navigation": false
  },
  "prototypeDir": "../prototype"
}
